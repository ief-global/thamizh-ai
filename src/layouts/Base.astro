---
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  /** The design-repo document this page derives from. Every page names one. */
  derivesFrom?: { label: string; href: string }[];
  noindex?: boolean;
}
const { title, description, derivesFrom = [], noindex = false } = Astro.props;
// build.format is 'file', so Astro.url.pathname here is '/why.html'. Cloudflare serves that
// at '/why', which is the address every link and every letter uses, so strip the extension.
// Getting this wrong also breaks the nav's current-page highlight, silently.
const path = (Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/$/, '')) || '/';
// Always the apex, never the host that happened to serve this build. Without it the
// workers.dev deployment and every preview URL compete with thamizh-ai.org in search.
const canonical = new URL(path, 'https://thamizh-ai.org').href;
// Flip to true while a page is written but not ready to be read, or while Tamil is
// awaiting review. One switch, so it cannot be half-done.
// Off since 2026-08-19: Saran read the Tamil and the layer names are settled.
const DRAFT = false;

const nav = [
  { href: '/why', label: 'Why' },
  { href: '/grammar', label: 'Grammar' },
  { href: '/morphology', label: 'Morphology' },
  { href: '/engine', label: 'Engine' },
  { href: '/sources', label: 'Sources' },
  { href: '/distribution', label: 'Distribution' },
  { href: '/horizon', label: 'Horizon' },
];
const subnav = [
  { href: '/status', label: 'Status' },
  { href: '/glossary', label: 'Glossary' },
  { href: '/about', label: 'About and contact' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="தமிழ்AI" />
  <link rel="preload" href="/fonts/noto-sans-tamil-tamil.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/noto-sans-tamil-latin.woff2" as="font" type="font/woff2" crossorigin />
  <meta name="theme-color" content="#7a1f2b" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  {DRAFT && (
    <div class="draft"><div class="wrap">
      <b>Draft</b> &nbsp;·&nbsp; this site is being written in the open. Every figure is verified; the
      prose is still being read. <a href="/about">Tell us what is wrong</a>.
    </div></div>
  )}

  <div class="topbar"><div class="wrap row">
    <a class="brand ta" href="/">தமிழ்<span class="ai">AI</span></a>
    <nav aria-label="Sections">
      {nav.map((n) => (
        <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
  </div></div>

  <main id="main">
    <slot />
  </main>

  <footer class="site"><div class="wrap">
    <nav class="subnav" aria-label="More">
      {subnav.map((n) => (
        <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
    {derivesFrom.length > 0 && (
      <p class="derives">
        This page derives from {derivesFrom.map((d, i) => (
          <>{i > 0 ? ' and ' : ''}<a href={d.href}>{d.label}</a></>
        ))}. Where they disagree, the document wins and this page needs fixing.
      </p>
    )}
    <p>
      A project of the <a href="https://ief-global.org">International Educational Foundation</a>, a nonprofit.
      Server code <a href="https://github.com/ief-global/thamizh-mcp">Apache-2.0</a>; the writing and diagrams here are CC BY-SA 4.0.
    </p>
    <p>
      Classical texts from Project Madurai, header intact. Morphological analysis by
      <a href="https://github.com/sarves/thamizhi-morph">ThamizhiMorph</a>, Sarveswaran, Dias and Butt 2021.
      <a href="https://github.com/ief-global/thamizh-ai/blob/main/public/img/CREDITS.md">Image credits</a>.
    </p>
  </div></footer>
</body>
</html>
