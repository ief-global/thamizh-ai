  english="Madras Tamil Lexicon"
  state="closed"
  lede="The most authoritative Tamil lexicon in existence, compiled at the University of Madras between 1924 and 1936. We may consult it and cite it. We may not bundle a line of it, and we have not."
  facts={[
    { label: 'Compiled', value: 'University of Madras, 1924–1936' },
    { label: 'Digitised by', value: 'Digital South Asia Library, University of Chicago' },
    { label: 'Licence', value: 'CC BY-NC-ND 2.0' },
    { label: 'Our status', value: 'Adapter exists as a stub and is off. Nothing has been scraped.' },
  ]}
  derivesFrom={[
    { label: 'DECISIONS.md D-016', href: 'https://github.com/ief-global/thamizh-mcp-design/blob/main/DECISIONS.md' },
