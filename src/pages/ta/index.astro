---
import Base from '../../layouts/Base.astro';

// The Tamil mirror. Routing exists from day one so the translation is a directory and
// not a second site. Nothing is published in Tamil until Saran has corrected it, so this
// page stays a placeholder rather than carrying a machine translation.
---
<Base title="தமிழ்AI — தமிழ் பக்கங்கள்" description="Tamil pages, in preparation." noindex={true}>
  <div class="wrap">
    <section>
      <p class="kicker">தமிழ்</p>
      <h2 class="ta">தமிழ்ப் பக்கங்கள் தயாராகின்றன</h2>
      <p class="ta">
        இந்தத் தளத்தின் முக்கியப் பக்கங்கள் தமிழில் வெளியிடப்படும். மொழிபெயர்ப்பு பரிசோதிக்கப்படாமல்
        வெளியிடப்படாது.
      </p>
      <p>
        The four pages an outreach letter links, <a href="/">home</a>, <a href="/why">why</a>,
        morphology and sources, are translated first. Nothing appears here until it has been read
        by a Tamil speaker, so this page is empty rather than machine translated.
      </p>
    </section>
  </div>
</Base>
